# Ephemeral Intent Synthesis System - Environment Configuration

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose your LLM provider: "ollama" (local) or "watsonx" (IBM Cloud)
# Set USE_OLLAMA=true to use local Ollama, false to use IBM watsonx.ai
USE_OLLAMA=true

# ----------------------------------------------------------------------------
# Ollama Configuration (Local AI - Recommended for Development)
# ----------------------------------------------------------------------------
# Install Ollama: https://ollama.ai/
# Start Ollama: ollama serve
# Pull models: ollama pull phi3:mini
#
# ⚠️  RAM GUIDE — pick the model that fits your free memory:
#   < 4 GB free  → phi3:mini  (2.2 GB) — fastest, works on any laptop
#   4–6 GB free  → llama3.2   (2.4 GB) — slightly richer output
#   6–8 GB free  → codellama:7b / mistral:7b — best for code topics
#   8 GB+ free   → any model, safe to raise num_predict back to 1200
#
# Default is phi3:mini — change only if you have headroom.
OLLAMA_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# IBM watsonx.ai Configuration (Cloud AI - For Production)
# ----------------------------------------------------------------------------
# Get your credentials from: https://cloud.ibm.com/
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model Configuration
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# Redis Configuration (for session state)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Biometric Analysis Configuration
# ============================================================================
# Thresholds for cognitive load classification
HIGH_STRESS_THRESHOLD=0.7
LOW_ATTENTION_THRESHOLD=0.4

# Minimum frames required for reliable analysis
MIN_FRAMES_FOR_ANALYSIS=30

# ============================================================================
# RAG Engine Configuration
# ============================================================================
# Vector store settings
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum sources to retrieve
MAX_RAG_SOURCES=5

# ============================================================================
# UI Orchestrator Configuration
# ============================================================================
# Presentation mode thresholds
VOICE_FIRST_THRESHOLD=0.7
TEXT_FIRST_THRESHOLD=0.3

# ============================================================================
# Lifecycle Management
# ============================================================================
# Session timeout in seconds
SESSION_TIMEOUT=300

# Cleanup interval in seconds
CLEANUP_INTERVAL=60

# ============================================================================
# Local Video Generator Configuration
# ============================================================================
# Set VIDEO_ENABLED=true once Piper + Wav2Lip + ffmpeg are installed.
# See LOCAL_VIDEO_GUIDE.md for full setup instructions.
VIDEO_ENABLED=false

# Piper TTS — download from https://github.com/rhasspy/piper/releases
# Windows example: C:/tools/piper/piper.exe
# Linux/macOS example: /usr/local/bin/piper
PIPER_BINARY=

# Piper voice model (.onnx file) — download from https://huggingface.co/rhasspy/piper-voices
# Recommended: en_US-lessac-medium  (~60 MB, excellent quality, CPU real-time)
PIPER_MODEL=

# Wav2Lip — clone from https://github.com/Rudrabha/Wav2Lip
# Point this to the root of the cloned repo
WAV2LIP_DIR=

# Wav2Lip pre-trained checkpoint (.pth file)
# Download wav2lip.pth from the Wav2Lip releases page
WAV2LIP_CHECKPOINT=

# Avatar image used as the talking face (neutral expression, ~512x512 px PNG/JPG)
AVATAR_IMAGE=

# Where generated MP4 files are stored
VIDEO_OUTPUT_DIR=./data/videos

# Maximum number of videos to keep on disk (LRU eviction)
VIDEO_MAX_CACHE_ITEMS=50

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# Security
# ============================================================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_with_openssl

# JWT expiration in minutes
JWT_EXPIRATION_MINUTES=60

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug mode (DO NOT use in production)
DEBUG=false

# Enable API documentation
ENABLE_DOCS=true

# Mock mode (use when watsonx.ai credentials not available)
MOCK_MODE=false